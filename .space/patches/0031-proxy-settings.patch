diff --git a/Tinycast/Features/Settings/Panes/ProxySettingsSection.swift b/Tinycast/Features/Settings/Panes/ProxySettingsSection.swift
new file mode 100644
index 0000000000000000000000000000000000000000..8db4e273e667529b0aff43e09f911848368eef3c
--- /dev/null
+++ b/Tinycast/Features/Settings/Panes/ProxySettingsSection.swift
@@ -0,0 +1,130 @@
+import SwiftUI
+
+struct ProxySettingsSection: View {
+    @Environment(AppSettings.self) private var settings
+    @State private var password = ""
+    @State private var passwordStored = false
+    @State private var passwordFailure: String?
+    @FocusState private var passwordFocused: Bool
+
+    var body: some View {
+        @Bindable var settings = settings
+        return Section {
+            Toggle(isOn: $settings.proxyEnabled) {
+                SettingsRowTitle(.generalNetwork, "Proxy")
+                Text("Route Tinycast's internet requests through this proxy.")
+            }
+            if settings.proxyEnabled {
+                Picker(selection: $settings.proxyKind) {
+                    ForEach(ProxyConfiguration.Kind.allCases) { kind in
+                        Text(verbatim: kind.title).tag(kind)
+                    }
+                } label: {
+                    Text("Type")
+                }
+                SettingsRow(
+                    title: String(localized: "Server"),
+                    subtitle: String(localized: "Host name or IP address and port.")
+                ) {
+                    TextField(
+                        "", text: $settings.proxyServer,
+                        prompt: Text(verbatim: "127.0.0.1:8080")
+                    )
+                    .labelsHidden()
+                    .font(.callout.monospaced())
+                    .multilineTextAlignment(.trailing)
+                    .autocorrectionDisabled()
+                    .frame(width: 240)
+                }
+                SettingsRow(
+                    title: String(localized: "Username"),
+                    subtitle: String(localized: "Optional.")
+                ) {
+                    TextField("", text: $settings.proxyUsername, prompt: Text(verbatim: "user"))
+                        .labelsHidden()
+                        .font(.callout.monospaced())
+                        .multilineTextAlignment(.trailing)
+                        .autocorrectionDisabled()
+                        .frame(width: 240)
+                }
+                SettingsRow(
+                    title: String(localized: "Password"),
+                    subtitle: passwordStored
+                        ? String(localized: "A password is stored in Keychain.")
+                        : String(localized: "Optional.")
+                ) {
+                    VStack(alignment: .trailing, spacing: Theme.Spacing.xxs) {
+                        ZStack(alignment: .trailing) {
+                            SecureField(
+                                "", text: $password,
+                                prompt: passwordStored
+                                    ? Text(verbatim: "••••••••") : Text("Optional")
+                            )
+                            .labelsHidden()
+                            .font(.callout.monospaced())
+                            .multilineTextAlignment(.trailing)
+                            .padding(.trailing, passwordStored ? 28 : 0)
+                            .frame(width: 240)
+                            .focused($passwordFocused)
+                            .onSubmit(savePassword)
+                            if passwordStored {
+                                Button(action: removePassword) {
+                                    Image(systemName: "trash")
+                                }
+                                .buttonStyle(.borderless)
+                                .foregroundStyle(.secondary)
+                                .padding(.trailing, 4)
+                                .help("Remove password")
+                                .accessibilityLabel("Remove password")
+                            }
+                        }
+                        if let passwordFailure {
+                            Text(passwordFailure)
+                                .font(.caption)
+                                .foregroundStyle(.orange)
+                        }
+                    }
+                }
+                if ProxyConfiguration.serverParts(from: settings.proxyServer) == nil {
+                    Label(
+                        "Enter a server and port, like 127.0.0.1:8080.",
+                        systemImage: "exclamationmark.triangle.fill"
+                    )
+                    .font(.caption)
+                    .foregroundStyle(.orange)
+                }
+            }
+        } header: {
+            SettingsSectionHeader(.generalNetwork)
+        }
+        .onAppear { passwordStored = ProxyCredentialStore.hasPassword }
+        .onChange(of: passwordFocused) { old, new in
+            if old && !new { savePassword() }
+        }
+        .onDisappear { savePassword() }
+    }
+
+    private func savePassword() {
+        let trimmed = password.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty else { return }
+        do {
+            try ProxyCredentialStore.setPassword(trimmed)
+            password = ""
+            passwordStored = true
+            passwordFailure = nil
+        } catch {
+            passwordFailure = String(localized: "The password could not be saved to Keychain.")
+        }
+    }
+
+    private func removePassword() {
+        do {
+            try ProxyCredentialStore.setPassword(nil)
+            password = ""
+            passwordStored = false
+            passwordFailure = nil
+        } catch {
+            passwordFailure = String(localized: "The password could not be removed from Keychain.")
+        }
+    }
+}
diff --git a/Tinycast/Features/Settings/Service/NetworkProxy.swift b/Tinycast/Features/Settings/Service/NetworkProxy.swift
new file mode 100644
index 0000000000000000000000000000000000000000..030aabfef846a06d6850615ac29341b514518f05
--- /dev/null
+++ b/Tinycast/Features/Settings/Service/NetworkProxy.swift
@@ -0,0 +1,48 @@
+import Foundation
+import Network
+
+/// Applies Settings' proxy to every private session; disabled or incomplete settings keep macOS's own.
+enum NetworkProxy {
+    static var current: ProxyConfiguration? {
+        let defaults = UserDefaults.standard
+        guard defaults.bool(forKey: AppSettingsKey.proxyEnabled.rawValue) else { return nil }
+        let kind =
+            defaults.string(forKey: AppSettingsKey.proxyKind.rawValue)
+            .flatMap(ProxyConfiguration.Kind.init(rawValue:)) ?? .http
+        let serverText = defaults.string(forKey: AppSettingsKey.proxyServer.rawValue) ?? ""
+        guard let server = ProxyConfiguration.serverParts(from: serverText) else { return nil }
+        let username = defaults.string(forKey: AppSettingsKey.proxyUsername.rawValue)
+        return ProxyConfiguration(
+            kind: kind, host: server.host, port: server.port, username: username,
+            password: ProxyCredentialStore.password)
+    }
+
+    /// `Network.ProxyConfiguration` is the only transport that carries SOCKS5 credentials; a
+    /// `connectionProxyDictionary` offers only the no-auth method and the proxy rejects the tunnel.
+    static func apply(to configuration: URLSessionConfiguration) {
+        configuration.connectionProxyDictionary = nil
+        guard let proxy = current,
+            let port = NWEndpoint.Port(rawValue: UInt16(proxy.port))
+        else {
+            configuration.proxyConfigurations = []
+            return
+        }
+        let endpoint = NWEndpoint.hostPort(host: NWEndpoint.Host(proxy.host), port: port)
+        var networkProxy: Network.ProxyConfiguration
+        switch proxy.kind {
+        case .http:
+            networkProxy = Network.ProxyConfiguration(httpCONNECTProxy: endpoint)
+        case .https:
+            networkProxy = Network.ProxyConfiguration(
+                httpCONNECTProxy: endpoint, tlsOptions: .init())
+        case .socks5:
+            networkProxy = Network.ProxyConfiguration(socksv5Proxy: endpoint)
+        }
+        if let username = proxy.username {
+            networkProxy.applyCredential(username: username, password: proxy.password ?? "")
+        }
+        networkProxy.allowFailover = false
+        networkProxy.excludedDomains = ["localhost", "127.0.0.1", "::1", "local"]
+        configuration.proxyConfigurations = [networkProxy]
+    }
+}
diff --git a/Tinycast/Features/Settings/Service/ProxyCredentialStore.swift b/Tinycast/Features/Settings/Service/ProxyCredentialStore.swift
new file mode 100644
index 0000000000000000000000000000000000000000..5ddb95344fed40075728170dd60f7630f8a9bd8b
--- /dev/null
+++ b/Tinycast/Features/Settings/Service/ProxyCredentialStore.swift
@@ -0,0 +1,23 @@
+import Foundation
+
+/// The optional proxy password, kept out of `UserDefaults`, settings.json and every backup.
+enum ProxyCredentialStore {
+    private static let store = KeychainSecretStore(scope: "network-proxy")
+    private static let account = UUID(uuidString: "7A3B0E52-3D7A-4C1E-9E2A-9C1D0B5F6A21")!
+
+    static var hasPassword: Bool {
+        (try? store.hasSecret(for: account)) ?? false
+    }
+
+    static var password: String? {
+        try? store.secret(for: account)
+    }
+
+    static func setPassword(_ password: String?) throws {
+        guard let password, !password.isEmpty else {
+            try store.removeSecret(for: account)
+            return
+        }
+        try store.setSecret(password, for: account)
+    }
+}
